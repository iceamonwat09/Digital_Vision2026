viqenv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# YOLO models (large files)
*.pt
!yolov8n.pt  # Keep small demo model if needed
runs/
weights/

# MongoDB
*.db
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Application specific
uploads/
*.jpg
*.png
!static/

# Environment variables
.env
.env.local

# Label Paper Inspection — runtime data, not source
credentials/
data/label_paper/inspections/
data/label_paper/reports/
# Rendered-master cache: regenerated on first inspect, no need to track
data/label_paper/skus/*/master_*dpi.png

# Artwork Proof Check — runtime data, not source
# (zone templates + brand vocab are kept in git so the team shares them)
data/artwork_check/inspections/

# Auth — JWT signing secret is generated per deployment, never commit it
data/auth/

# TLS certs for HTTPS (self-signed, generated per machine via generate_cert.py)
certs/

# ชุดไฟล์ artwork สำหรับ verify_ocr.py — เป็นงานลูกค้า ไม่ควรขึ้น repo
TEST/

# กล้องอุตสาหกรรม Hikrobot — ของเฉพาะเครื่อง ห้ามเข้า repo
data/hik_camera.json          # ค่าตั้งกล้องของเครื่องนั้น ๆ (ต่างสถานีต่างค่า)
data/hik_dataset/             # ภาพความละเอียดเต็มที่เก็บไว้เทรน (ใหญ่มาก)
data/hik_burst/               # ภาพจากโหมด "ถ่ายรัว" (10 วิ ≈ 200 MB — ลบได้จากหน้าเว็บ)
hik_shots/                    # ภาพตัวอย่างจาก diagnose_hikrobot.py --save-dir
hik*.json                     # ผลจาก diagnose_hikrobot.py --json
